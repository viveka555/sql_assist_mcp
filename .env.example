
# Groq LLM configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# PostgreSQL configuration
# We'll set the actual database credentials later.
DATABASE_URL=postgresql+asyncpg://mcp_reader:change_me@localhost:5432/sql_assistant

# API authentication
API_TOKEN=replace-with-a-long-random-secret

# SQL execution safeguards
SQL_MAX_ROWS=100
SQL_TIMEOUT_SECONDS=10
